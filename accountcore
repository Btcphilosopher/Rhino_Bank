@dataclass
class Position:
    symbol: str
    quantity: Decimal = Decimal("0")
    average_price: Decimal = Decimal("0")

    def market_value(self, price) -> Decimal:
        return self.quantity * money(price)

    def buy(self, quantity, price) -> None:
        quantity = money(quantity)
        price = money(price)

        if quantity <= 0 or price <= 0:
            raise ValueError("Quantity and price must be positive.")

        old_value = self.quantity * self.average_price
        new_value = quantity * price

        self.quantity += quantity

        if self.quantity > 0:
            self.average_price = (
                old_value + new_value
            ) / self.quantity

    def sell(self, quantity) -> None:
        quantity = money(quantity)

        if quantity <= 0:
            raise ValueError("Quantity must be positive.")

        if quantity > self.quantity:
            raise ValueError(
                f"Cannot sell {quantity} {self.symbol}; "
                f"position is {self.quantity}."
            )

        self.quantity -= quantity

        if self.quantity == 0:
            self.average_price = Decimal("0")


@dataclass
class Order:
    order_id: str
    symbol: str
    side: OrderSide
    quantity: Decimal
    price: Decimal
    status: OrderStatus = OrderStatus.OPEN
    filled_quantity: Decimal = Decimal("0")
    created_at: datetime = field(default_factory=now)

    @property
    def remaining_quantity(self) -> Decimal:
        return self.quantity - self.filled_quantity

    @property
    def notional(self) -> Decimal:
        return self.quantity * self.price


@dataclass
class Trade:
    trade_id: str
    order_id: str
    symbol: str
    side: OrderSide
    quantity: Decimal
    price: Decimal
    executed_at: datetime = field(default_factory=now)

    @property
    def notional(self) -> Decimal:
        return self.quantity * self.price


@dataclass
class TradingBook:
    buying_power: Decimal = Decimal("0")
    orders: Dict[str, Order] = field(default_factory=dict)
    positions: Dict[str, Position] = field(default_factory=dict)
    trade_blotter: List[Trade] = field(default_factory=list)

    def set_buying_power(self, amount) -> None:
        amount = money(amount)

        if amount < 0:
            raise ValueError("Buying power cannot be negative.")

        self.buying_power = amount

    def create_order(
        self,
        symbol: str,
        side: OrderSide,
        quantity,
        price
    ) -> Order:

        quantity = money(quantity)
        price = money(price)

        if quantity <= 0:
            raise ValueError("Quantity must be positive.")

        if price <= 0:
            raise ValueError("Price must be positive.")

        notional = quantity * price

        if side == OrderSide.BUY and notional > self.buying_power:
            raise ValueError(
                f"Insufficient buying power: "
                f"required={notional}, "
                f"available={self.buying_power}"
            )

        order = Order(
            order_id=new_id("ord"),
            symbol=symbol.upper(),
            side=side,
            quantity=quantity,
            price=price,
        )

        self.orders[order.order_id] = order

        return order

    def execute_order(
        self,
        order_id: str,
        fill_quantity,
        fill_price
    ) -> Trade:

        if order_id not in self.orders:
            raise KeyError(f"Unknown order: {order_id}")

        order = self.orders[order_id]

        if order.status not in (
            OrderStatus.OPEN,
            OrderStatus.PARTIALLY_FILLED
        ):
            raise ValueError(
                f"Order {order_id} is not executable."
            )

        fill_quantity = money(fill_quantity)
        fill_price = money(fill_price)

        if fill_quantity <= 0:
            raise ValueError("Fill quantity must be positive.")

        if fill_quantity > order.remaining_quantity:
            raise ValueError(
                "Fill exceeds remaining order quantity."
            )

        notional = fill_quantity * fill_price

        position = self.positions.setdefault(
            order.symbol,
            Position(symbol=order.symbol)
        )

        if order.side == OrderSide.BUY:

            if notional > self.buying_power:
                raise ValueError(
                    "Execution would exceed buying power."
                )

            self.buying_power -= notional
            position.buy(fill_quantity, fill_price)

        else:
            position.sell(fill_quantity)

        order.filled_quantity += fill_quantity

        if order.filled_quantity == order.quantity:
            order.status = OrderStatus.FILLED
        else:
            order.status = OrderStatus.PARTIALLY_FILLED

        trade = Trade(
            trade_id=new_id("trd"),
            order_id=order.order_id,
            symbol=order.symbol,
            side=order.side,
            quantity=fill_quantity,
            price=fill_price,
        )

        self.trade_blotter.append(trade)

        return trade

    def cancel_order(self, order_id: str) -> None:
        if order_id not in self.orders:
            raise KeyError(f"Unknown order: {order_id}")

        order = self.orders[order_id]

        if order.status not in (
            OrderStatus.OPEN,
            OrderStatus.PARTIALLY_FILLED
        ):
            raise ValueError("Order cannot be cancelled.")

        order.status = OrderStatus.CANCELLED


