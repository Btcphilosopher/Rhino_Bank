# ENUMERATIONS
# ============================================================

class Role(str, Enum):
    ADMIN = "ADMIN"
    TREASURER = "TREASURER"
    TRADER = "TRADER"
    OPERATIONS = "OPERATIONS"
    RISK = "RISK"
    VIEWER = "VIEWER"


class OrderSide(str, Enum):
    BUY = "BUY"
    SELL = "SELL"


class OrderStatus(str, Enum):
    OPEN = "OPEN"
    PARTIALLY_FILLED = "PARTIALLY_FILLED"
    FILLED = "FILLED"
    CANCELLED = "CANCELLED"
    REJECTED = "REJECTED"


class SettlementType(str, Enum):
    FIAT = "FIAT"
    USDT = "USDT"
    PHYSICAL = "PHYSICAL"


