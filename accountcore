    status: str = "PENDING"
    created_at: datetime = field(default_factory=now)


@dataclass
class PhysicalBook:
    inventory: Dict[str, Decimal] = field(default_factory=dict)
    lots: Dict[str, Lot] = field(default_factory=dict)
    listings: Dict[str, Listing] = field(default_factory=dict)
    deliveries: Dict[str, Delivery] = field(default_factory=dict)

    def add_lot(
        self,
        asset: str,
        quantity,
        unit: str,
        location: str
    ) -> Lot:

        quantity = money(quantity)

        if quantity <= 0:
            raise ValueError("Quantity must be positive.")

        lot = Lot(
            lot_id=new_id("lot"),
            asset=asset.upper(),
            quantity=quantity,
            unit=unit,
            location=location,
        )

        self.lots[lot.lot_id] = lot

        self.inventory[lot.asset] = (
            self.inventory.get(lot.asset, Decimal("0"))
            + quantity
        )

        return lot

    def create_listing(
        self,
        lot_id: str,
        quantity,
        asking_price,
        currency: str
    ) -> Listing:

        if lot_id not in self.lots:
            raise KeyError(f"Unknown lot: {lot_id}")

        lot = self.lots[lot_id]
        quantity = money(quantity)

        if quantity <= 0 or quantity > lot.quantity:
            raise ValueError("Invalid listing quantity.")

        listing = Listing(
            listing_id=new_id("lst"),
            lot_id=lot_id,
            asset=lot.asset,
            quantity=quantity,
            asking_price=money(asking_price),
            currency=currency.upper(),
        )

        self.listings[listing.listing_id] = listing

        return listing

    def schedule_delivery(
        self,
        lot_id: str,
        quantity,
        destination: str
    ) -> Delivery:

        if lot_id not in self.lots:
            raise KeyError(f"Unknown lot: {lot_id}")

        lot = self.lots[lot_id]
        quantity = money(quantity)

        if quantity <= 0 or quantity > lot.quantity:
            raise ValueError("Invalid delivery quantity.")

        delivery = Delivery(
            delivery_id=new_id("del"),
            lot_id=lot_id,
            destination=destination,
            quantity=quantity,
        )

        self.deliveries[delivery.delivery_id] = delivery

        return delivery


