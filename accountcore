@dataclass
class Settlement:
    settlement_id: str
    settlement_type: SettlementType
    reference: str
    amount: Decimal
    currency_or_asset: str
    status: str = "PENDING"
    created_at: datetime = field(default_factory=now)


@dataclass
class SettlementBook:
    fiat: List[Settlement] = field(default_factory=list)
    usdt: List[Settlement] = field(default_factory=list)
    physical: List[Settlement] = field(default_factory=list)

    def create(
        self,
        settlement_type: SettlementType,
        reference: str,
        amount,
        currency_or_asset: str
    ) -> Settlement:

        settlement = Settlement(
            settlement_id=new_id("stl"),
            settlement_type=settlement_type,
            reference=reference,
            amount=money(amount),
            currency_or_asset=currency_or_asset.upper(),
        )

        if settlement_type == SettlementType.FIAT:
            self.fiat.append(settlement)

        elif settlement_type == SettlementType.USDT:
            self.usdt.append(settlement)

        elif settlement_type == SettlementType.PHYSICAL:
            self.physical.append(settlement)

        return settlement

    def complete(self, settlement_id: str) -> None:

        books = (
            self.fiat,
            self.usdt,
            self.physical
        )

        for book in books:

            for settlement in book:

                if settlement.settlement_id == settlement_id:
                    settlement.status = "SETTLED"
                    return

        raise KeyError(
            f"Unknown settlement: {settlement_id}"
        )


