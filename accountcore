@dataclass
class TradingLimits:
    max_order_notional: Decimal = Decimal("1000000")
    max_position_notional: Decimal = Decimal("5000000")
    max_daily_notional: Decimal = Decimal("10000000")


@dataclass
class RiskBook:
    credit_limit: Decimal = Decimal("0")
    trading_limits: TradingLimits = field(
        default_factory=TradingLimits
    )

    asset_limits: Dict[str, Decimal] = field(default_factory=dict)

    exposure: Dict[str, Decimal] = field(default_factory=dict)

    def set_credit_limit(self, amount) -> None:
        amount = money(amount)

        if amount < 0:
            raise ValueError("Credit limit cannot be negative.")

        self.credit_limit = amount

    def set_asset_limit(self, asset: str, limit) -> None:
        limit = money(limit)

        if limit < 0:
            raise ValueError("Asset limit cannot be negative.")

        self.asset_limits[asset.upper()] = limit

    def update_exposure(self, asset: str, value) -> None:
        self.exposure[asset.upper()] = money(value)

    def check_order(
        self,
        symbol: str,
        notional
    ) -> bool:

        symbol = symbol.upper()
        notional = money(notional)

        if notional > self.trading_limits.max_order_notional:
            return False

        asset_limit = self.asset_limits.get(symbol)

        if asset_limit is not None:

            current = self.exposure.get(
                symbol,
                Decimal("0")
            )

            if current + notional > asset_limit:
                return False

        return True

    def risk_report(self) -> dict:
        return {
            "credit_limit": str(self.credit_limit),
            "exposure": {
                asset: str(value)
                for asset, value in self.exposure.items()
            },
            "asset_limits": {
                asset: str(value)
                for asset, value in self.asset_limits.items()
            },
            "trading_limits": {
                "max_order_notional":
                    str(self.trading_limits.max_order_notional),
                "max_position_notional":
                    str(self.trading_limits.max_position_notional),
                "max_daily_notional":
                    str(self.trading_limits.max_daily_notional),
            }
        }


