@dataclass
class Wallet:
    currency: str
    available: Decimal = Decimal("0")
    reserved: Decimal = Decimal("0")

    @property
    def total(self) -> Decimal:
        return self.available + self.reserved

    def credit(self, amount: Decimal) -> None:
        amount = money(amount)

        if amount <= 0:
            raise ValueError("Credit must be positive.")

        self.available += amount

    def debit(self, amount: Decimal) -> None:
        amount = money(amount)

        if amount <= 0:
            raise ValueError("Debit must be positive.")

        if amount > self.available:
            raise ValueError(
                f"Insufficient {self.currency} balance."
            )

        self.available -= amount

    def reserve(self, amount: Decimal) -> None:
        amount = money(amount)

        if amount <= 0:
            raise ValueError("Reserve must be positive.")

        if amount > self.available:
            raise ValueError(
                f"Insufficient available {self.currency}."
            )

        self.available -= amount
        self.reserved += amount

    def release(self, amount: Decimal) -> None:
        amount = money(amount)

        if amount <= 0:
            raise ValueError("Release must be positive.")

        if amount > self.reserved:
            raise ValueError(
                f"Cannot release more than reserved {self.currency}."
            )

        self.reserved -= amount
        self.available += amount


@dataclass
class Treasury:
    wallets: Dict[str, Wallet] = field(default_factory=dict)

    SUPPORTED_CURRENCIES = ("USD", "GBP", "EUR", "USDT")

    def __post_init__(self):
        for currency in self.SUPPORTED_CURRENCIES:
            self.wallets.setdefault(
                currency,
                Wallet(currency=currency)
            )

    def wallet(self, currency: str) -> Wallet:
        currency = currency.upper()

        if currency not in self.wallets:
            raise ValueError(
                f"Unsupported treasury currency: {currency}"
            )

        return self.wallets[currency]

    def deposit(self, currency: str, amount) -> None:
        self.wallet(currency).credit(money(amount))

    def withdraw(self, currency: str, amount) -> None:
        self.wallet(currency).debit(money(amount))

    def reserve(self, currency: str, amount) -> None:
        self.wallet(currency).reserve(money(amount))

    def release(self, currency: str, amount) -> None:
        self.wallet(currency).release(money(amount))

    def snapshot(self) -> dict:
        return {
            currency: {
                "available": str(wallet.available),
                "reserved": str(wallet.reserved),
                "total": str(wallet.total),
            }
            for currency, wallet in self.wallets.items()
        }


