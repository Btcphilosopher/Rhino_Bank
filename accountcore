@dataclass
class RhinoBankAccount:

    identity: Identity

    treasury: Treasury = field(
        default_factory=Treasury
    )

    trading: TradingBook = field(
        default_factory=TradingBook
    )

    physical: PhysicalBook = field(
        default_factory=PhysicalBook
    )

    risk: RiskBook = field(
        default_factory=RiskBook
    )

    settlement: SettlementBook = field(
        default_factory=SettlementBook
    )

    audit_log: List[AuditEvent] = field(
        default_factory=list
    )

    # --------------------------------------------------------
    # AUDIT
    # --------------------------------------------------------

    def audit(
        self,
        event_type: str,
        data: dict
    ) -> None:

        self.audit_log.append(
            AuditEvent(
                event_id=new_id("evt"),
                event_type=event_type,
                actor=self.identity.account_id,
                data=data,
            )
        )

    # --------------------------------------------------------
    # TREASURY API
    # --------------------------------------------------------

    def deposit(self, currency: str, amount) -> None:

        self.treasury.deposit(currency, amount)

        self.audit(
            "TREASURY_DEPOSIT",
            {
                "currency": currency,
                "amount": str(amount),
            }
        )

    # --------------------------------------------------------
    # ORDER API
    # --------------------------------------------------------

    def place_order(
        self,
        symbol: str,
        side: OrderSide,
        quantity,
        price
    ) -> Order:

        quantity = money(quantity)
        price = money(price)

        notional = quantity * price

        # Risk gateway
        if not self.risk.check_order(
            symbol,
            notional
        ):
            raise PermissionError(
                f"Risk limits rejected order "
                f"for {symbol}."
            )

        order = self.trading.create_order(
            symbol,
            side,
            quantity,
            price
        )

        self.audit(
            "ORDER_CREATED",
            {
                "order_id": order.order_id,
                "symbol": symbol,
                "side": side.value,
                "quantity": str(quantity),
                "price": str(price),
                "notional": str(notional),
            }
        )

        return order

    def execute_order(
        self,
        order_id: str,
        quantity,
        price
    ) -> Trade:

        trade = self.trading.execute_order(
            order_id,
            quantity,
            price
        )

        self.audit(
            "TRADE_EXECUTED",
            {
                "trade_id": trade.trade_id,
                "order_id": trade.order_id,
                "symbol": trade.symbol,
                "side": trade.side.value,
                "quantity": str(trade.quantity),
                "price": str(trade.price),
            }
        )

        return trade

    # --------------------------------------------------------
    # PHYSICAL API
    # --------------------------------------------------------

    def acquire_physical(
        self,
        asset: str,
        quantity,
        unit: str,
        location: str
    ) -> Lot:

        lot = self.physical.add_lot(
            asset,
            quantity,
            unit,
            location
        )

        self.audit(
            "PHYSICAL_ACQUISITION",
            {
                "lot_id": lot.lot_id,
                "asset": lot.asset,
                "quantity": str(lot.quantity),
                "unit": lot.unit,
                "location": lot.location,
            }
        )

        return lot

    # --------------------------------------------------------
    # SETTLEMENT API
    # --------------------------------------------------------

    def create_settlement(
        self,
        settlement_type: SettlementType,
        reference: str,
        amount,
        asset: str
    ) -> Settlement:

        settlement = self.settlement.create(
            settlement_type,
            reference,
            amount,
            asset
        )

        self.audit(
            "SETTLEMENT_CREATED",
            {
                "settlement_id": settlement.settlement_id,
                "type": settlement_type.value,
                "reference": reference,
                "amount": str(amount),
                "asset": asset,
            }
        )

        return settlement

    # --------------------------------------------------------
    # ACCOUNT SNAPSHOT
    # --------------------------------------------------------

    def snapshot(self) -> dict:

        return {
            "identity": {
                "account_id":
                    self.identity.account_id,

                "institutional_name":
                    self.identity.institutional_name,

                "role":
                    self.identity.role.value,

                "permissions":
                    sorted(self.identity.permissions),
            },

            "treasury":
                self.treasury.snapshot(),

            "trading": {
                "buying_power":
                    str(self.trading.buying_power),

                "open_orders": [
                    {
                        "order_id": order.order_id,
                        "symbol": order.symbol,
                        "side": order.side.value,
                        "quantity": str(order.quantity),
                        "filled": str(order.filled_quantity),
                        "price": str(order.price),
                        "status": order.status.value,
                    }
                    for order in self.trading.orders.values()
                    if order.status in (
                        OrderStatus.OPEN,
                        OrderStatus.PARTIALLY_FILLED
                    )
                ],

                "positions": {
                    symbol: {
                        "quantity":
                            str(position.quantity),

                        "average_price":
                            str(position.average_price),
                    }
                    for symbol, position
                    in self.trading.positions.items()
                },

                "trade_blotter": [
                    {
                        "trade_id": trade.trade_id,
                        "symbol": trade.symbol,
                        "side": trade.side.value,
                        "quantity": str(trade.quantity),
                        "price": str(trade.price),
                        "notional": str(trade.notional),
                    }
                    for trade in self.trading.trade_blotter
                ],
            },

            "physical": {
                "inventory": {
                    asset: str(quantity)
                    for asset, quantity
                    in self.physical.inventory.items()
                },

                "lots": {
                    lot_id: {
                        "asset": lot.asset,
                        "quantity": str(lot.quantity),
                        "unit": lot.unit,
                        "location": lot.location,
                    }
                    for lot_id, lot
                    in self.physical.lots.items()
                },
            },

            "risk":
                self.risk.risk_report(),

            "settlement": {
                "fiat":
                    len(self.settlement.fiat),

                "usdt":
                    len(self.settlement.usdt),

                "physical":
                    len(self.settlement.physical),
            },

            "audit_events":
                len(self.audit_log),
        }


