"""
RHINOBANK ACCOUNT CORE
=======================

Institutional multi-asset account model.

Domains:
    Identity
    Treasury
    Trading
    Physical
    Risk
    Settlement

This is an in-memory prototype intended as the foundation for
an enterprise banking / trading platform.

For production:
    - PostgreSQL should replace in-memory state
    - Decimal values should be persisted as exact numeric types
    - All state changes should be append-only ledger events
    - Authentication/authorization should be externalized
    - Orders should pass through a proper OMS/risk gateway
"""

from __future__ import annotations

from dataclasses import dataclass, field
from datetime import datetime, timezone
from decimal import Decimal, InvalidOperation
from enum import Enum
from typing import Dict, List, Optional
from uuid import uuid4


# ============================================================
# UTILITIES
# ============================================================

def now() -> datetime:
    return datetime.now(timezone.utc)


def money(value) -> Decimal:
    """Convert a value into an exact Decimal."""
    try:
        return Decimal(str(value))
    except InvalidOperation as exc:
        raise ValueError(f"Invalid monetary value: {value}") from exc


def new_id(prefix: str) -> str:
    return f"{prefix}_{uuid4().hex[:16]}"


